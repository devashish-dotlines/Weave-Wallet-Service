{
    "name": "wallet",
    "version": "1.0.0",
    "description": "Wallet microservice (DDD-flavoured layered TypeScript REST API)",
    "main": "index.ts",
    "scripts": {
        "start:build": "tsc -W --watchFile priorityPollingInterval",
        "start:run": "nodemon --legacy-watch --watch build build/index.js",
        "start": "concurrently npm:start:*",
        "build": "tsc -p .",
        "serve": "node build/index.js",
        "start:once": "tsc -p . && node build/index.js",
        "format": "prettier --write \"src/**/*.ts\""
    },
