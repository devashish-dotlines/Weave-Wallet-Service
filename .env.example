# Copy to .env and fill in. The process throws at startup on missing/invalid keys
# (validated by Zod in src/config/index.ts).

NODE_ENV=development
PORT=9046

# Database
DB_USER=postgres
DB_PASS=secret
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres       # mysql | postgres | mariadb | mssql
DB_DEV_DB_NAME=wallet_dev
DB_TEST_DB_NAME=wallet_test
DB_PROD_DB_NAME=wallet_prod
# DB_SYNC=true            # dev only: sequelize.sync({ alter: true }) on boot. NEVER in prod.

# Auth. Requests arrive THROUGH APISix, which has already verified the Keycloak
# token; this service only DECODES the forwarded JWT (it does NOT re-verify).
# JWT_SECRET is used only by the AuthToken/crypto helpers for locally-minted tokens.
JWT_SECRET=change-me

# Redis (optional — enabled only when REDIS_SERVER_STATUS=true)
REDIS_SERVER_STATUS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional comma-separated IP allowlist
# IP_WHITELIST=127.0.0.1,10.0.0.1

# Accounts PermissionService (single RBAC authority) — inter-service gRPC CLIENT.
# This service resolves a principal's role refs → permission codes from Accounts
# to gate config endpoints (superusers always bypass). ACCOUNTS_API_KEY is a
# service key issued by Accounts (POST /v1/accounts/services), NOT a JWT. Unset
# ACCOUNTS_GRPC_TARGET ⇒ permission checks deny non-superusers (fail-closed).
# ACCOUNTS_GRPC_TARGET=localhost:50061
# ACCOUNTS_API_KEY=svc_...
ACCOUNTS_GRPC_DEADLINE_MS=3000
PERMISSION_CACHE_TTL_MS=10000

# Workflow engine (inter-service gRPC CLIENT) — drives the wallet lifecycle
# (FR-WL-6). WORKFLOW_API_KEY is a service key issued by Accounts, NOT a JWT.
# WALLET_TYPE_ID is the engine WorkflowType id configured for entity_type
# 'wallet'. When these are unset, wallet creation still works but skips workflow
# initiate (wallet stays at its local default status 'pending').
# WORKFLOW_GRPC_TARGET=localhost:50051
# WORKFLOW_API_KEY=svc_...
# WORKFLOW_MODULE_ID=wallet
# WALLET_TYPE_ID=
WORKFLOW_GRPC_DEADLINE_MS=10000
# Approval workflow for manual bank-deposit top-ups (entity type wallet_topup_request).
# Unset => top-up requests can be drafted but not submitted.
TOPUP_REQUEST_TYPE_ID=

# Usage restrictions — what a wallet's balance may be spent on.
#   off     restrictions are stored and shown, never checked (default)
#   shadow  checked, the would-be rejection is logged, the spend still proceeds
#   enforce a spend that breaches a restriction is rejected
# A restricted dimension missing from the spend's usageContext fails CLOSED, so
# go through 'shadow' first — flipping straight to 'enforce' rejects every
# caller that hasn't been taught to send context yet.
USAGE_RESTRICTION_MODE=off

# Inbound gRPC server (EntityStatus push from the engine). Runs as its own
# process via `npm run grpc`.
GRPC_PORT=50072
GRPC_BIND_ADDRESS=127.0.0.1

# Object storage for top-up deposit slips. local (default) or s3.
# STORAGE_LOCAL_ROOT must NOT be `media` (served publicly by app.ts).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_MAX_FILE_BYTES=10485760
STORAGE_ALLOWED_MIME=application/pdf,image/png,image/jpeg
# Required when STORAGE_DRIVER=s3:
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=wallet
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_PREFIX=

# Configuration service (top-up bank accounts + limits, type WALLET_TOPUP).
CONFIG_GRPC_TARGET=localhost:50061
CONFIG_API_KEY=
CONFIG_GRPC_DEADLINE_MS=3000
CONFIG_CACHE_TTL_MS=60000

# Accounting LedgerService (voucher posting for wallet movements).
ACCOUNTING_GRPC_TARGET=localhost:50081
ACCOUNTING_API_KEY=
ACCOUNTING_GRPC_DEADLINE_MS=5000
WALLET_GL_POSTING_ENABLED=false
GL_RECONCILE_INTERVAL_SECONDS=300
GL_RECONCILE_BATCH_SIZE=50
GL_RECONCILE_MIN_AGE_SECONDS=60
# A movement whose posting failed is retried after this long (poison rows can't starve the sweep).
GL_RECONCILE_RETRY_AFTER_SECONDS=3600
