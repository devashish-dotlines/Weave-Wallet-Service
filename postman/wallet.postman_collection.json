{
  "info": {
    "name": "WF-Micro-SVC Wallet Service (Catena ERP)",
    "description": "Wallet module REST API (first pass: config + wallet CRUD, workflow-integrated). Requests go through the APISix gateway, which maps the public prefix `/api/wallet/*` onto the service's internal `/api/v1/wallet/*`. Set {{baseUrl}} to the gateway and {{token}} to a gateway JWT whose principal holds the relevant `wallet.*` permissions (or is a superuser). Create requests auto-capture the new id into a collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "balanceTypeId",
      "value": ""
    },
    {
      "key": "uomId",
      "value": ""
    },
    {
      "key": "ownerTypeId",
      "value": ""
    },
    {
      "key": "walletTypeId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "toWalletId",
      "value": ""
    },
    {
      "key": "txId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "serviceApiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Keycloak",
      "item": [
        {
          "name": "Get user token (password grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.environment.set(\"token\", json.access_token);",
                  "  console.log('Saved access_token to {{token}}');",
                  "}",
                  "pm.test('got access_token', () => pm.expect(json.access_token).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{kcLoginClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{kcLoginClientSecret}}",
                  "description": "only if the login client is confidential",
                  "disabled": true
                },
                {
                  "key": "username",
                  "value": "{{kcUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{kcPassword}}"
                }
              ]
            },
            "url": {
              "raw": "{{kcBaseUrl}}/realms/{{kcRealm}}/protocol/openid-connect/token",
              "host": [
                "{{kcBaseUrl}}"
              ],
              "path": [
                "realms",
                "{{kcRealm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Human user token from Keycloak. The test script saves access_token into the shared {{token}} variable used by every request."
          },
          "response": []
        }
      ]
    },
