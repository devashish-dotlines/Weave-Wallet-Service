    {
      "name": "Transactions",
      "item": [
        {
          "name": "Top up (credit) wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/wallets/{{walletId}}/topup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "wallets",
                "{{walletId}}",
                "topup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"description\": \"Initial top-up\",\n  \"idempotencyKey\": \"topup-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Credits the wallet and records a WTX credit row; updates cached balance atomically. idempotencyKey is optional — a repeat with the same key returns the original transaction id."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  const v = (b && typeof b === 'object') ? (b.debitTransactionId || b.id) : b;",
                  "  if (v) pm.collectionVariables.set('txId', v);",
                  "  console.log('txId =', v);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/wallets/{{walletId}}/debit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "wallets",
                "{{walletId}}",
                "debit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120,\n  \"description\": \"Purchase\",\n  \"idempotencyKey\": \"debit-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Debits the wallet. Rejected if it would breach available balance (unless the wallet type allows overdraft within its limit) or per-wallet minBalance."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  const v = (b && typeof b === 'object') ? (b.debitTransactionId || b.id) : b;",
                  "  if (v) pm.collectionVariables.set('txId', v);",
                  "  console.log('txId =', v);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer to another wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/wallets/{{walletId}}/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "wallets",
                "{{walletId}}",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toWalletId\": \"{{toWalletId}}\",\n  \"amount\": 75,\n  \"description\": \"Move funds\",\n  \"idempotencyKey\": \"transfer-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Atomic debit(source)+credit(destination), two linked WTX rows. Both wallets must share the same UOM (no FX yet) and be operable; source wallet type must allow transfers out. Set {{toWalletId}} to a second wallet's id."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  const v = (b && typeof b === 'object') ? (b.debitTransactionId || b.id) : b;",
                  "  if (v) pm.collectionVariables.set('txId', v);",
                  "  console.log('txId =', v);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Recompute balance",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallet/wallets/{{walletId}}/recompute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "wallets",
                "{{walletId}}",
                "recompute"
              ]
            },
            "description": "Re-derives the cached balance from completed transaction rows (interim ledger): balance = Σ credits − Σ debits."
          },
          "response": []
        },
        {
          "name": "List wallet transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallet/wallets/{{walletId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
